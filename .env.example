# Every setting here has a default in docker-compose.yml. Override only the
# ones you care about — an empty .env is fine. The file itself is NOT
# optional: compose reads it and refuses to start when it is missing, so
# `cp .env.example .env` before the first `docker compose up`.

# Override the LAN-shared bearer token used by Claude Code clients. If unset,
# the container generates one on first start and persists it to
# /data/.mcp_secret (retrieve with `docker compose exec infoguana cat /data/.mcp_secret`).
# INFOGUANA_MCP_SECRET=

# Pin a different classifier model.
# INFOGUANA_CLASSIFY_MODEL=claude-haiku-4-5

# Classify over HTTP instead of shelling out to the Claude CLI. Point this at
# any OpenAI-compatible /v1 endpoint — LM Studio, Ollama, vLLM, OpenAI. The
# CLI only exists on machines running Claude Code, so a headless or
# Codex-only install has no classifier until you set this. Set the model to
# one the endpoint actually serves; the default above names a Claude model.
# The API key is optional and usually unset for a local server.
# INFOGUANA_CLASSIFY_BASE_URL=http://127.0.0.1:1234/v1
# INFOGUANA_CLASSIFY_API_KEY=
# INFOGUANA_CLASSIFY_TIMEOUT=180

# GitHub integration for the chat. Read token is a personal PAT; bot tokens
# is a JSON map of project -> PAT (or path to a file containing the PAT).
# INFOGUANA_GITHUB_READ_TOKEN=
# INFOGUANA_GITHUB_BOT_TOKENS={"my-project":"/path/to/.bot-token"}

# Roots the read-only filesystem tools can see (colon-separated). Unset means
# no roots, which turns read_file / list_dir / grep off entirely.
# INFOGUANA_FS_ALLOWLIST=/root/code

# Host/Origin values allowed to reach the MCP endpoint, beyond loopback
# (comma-separated; ':*' wildcards the port). Setting this turns on
# DNS-rebinding protection; leaving it unset performs no Host/Origin checks.
# INFOGUANA_MCP_ALLOWED_HOSTS=10.0.0.5:*,infoguana.tailnet.ts.net
